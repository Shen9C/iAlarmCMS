# 使用Python 3.12作为基础镜像
FROM oilfield-web-base:v1.0.0

# 设置工作目录
WORKDIR /zhyn

# # # 安装系统依赖
# RUN apt-get update && apt-get install -y \
#     curl \
#     # gcc \
#     && rm -rf /var/lib/apt/lists/*

# # 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖和编译脚本
COPY requirements.txt .
# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 创建必要的目录
RUN mkdir -p \
    /zhyn/alarm_images \
    /zhyn/app \
    /zhyn/backups \
    /zhyn/config \
    /zhyn/logs \
    /zhyn/migrations \
    /zhyn/scripts \
    /zhyn/ssl \
    /zhyn/tests

# 复制业务代码
COPY app/ /zhyn/app/
COPY scripts/ /zhyn/scripts/
COPY config/ /zhyn/config/
COPY migrations/ /zhyn/migrations/
COPY run.py .
COPY start_api_server.py .
COPY start_web_app.py .
COPY wsgi.py .

# # 编译Cython扩展
# RUN python setup.py build_ext --inplace

# 清理.c文件
RUN find ./app ./scripts ./config -name "*.c" -delete

# 删除源码，仅保留so文件（保留入口py文件）
# RUN find ./app ./scripts ./config -name "*.py" ! -name "__init__.py" -delete
# 只有app目录下的py文件
RUN find ./app -name "*.py" ! -name "__init__.py" -delete

# 设置环境变量
ENV PYTHONPATH=/zhyn
ENV FLASK_APP=run.py
ENV FLASK_ENV=production

# 暴露端口
EXPOSE 8000 8800

# 启动命令
CMD ["python", "run.py", "--no-ssl"]